generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int          @id @default(autoincrement())
  email      String       @unique
  name       String
  password      String
  heritage Heritage[]
}

model Heritage {
  id         Int          @id @default(autoincrement())
  assets       Assets[]
  claims   Claims[]
  obligations Obligations[]
  userId  Int
  user    User      @relation(fields: [userId], references: [id])
}

model Assets {
  id                  Int                        @id @default(autoincrement())
  real_estate         Real_State[]
  lands               Lands[]
  vehicles            Vehicles[]
  equity_interests       Equity_Interests[]
  other_investments Other_Investments[]
  heritageId        Int
  heritage      Heritage                 @relation(fields: [heritageId], references: [id])
}

model Claims {
  id             Int        @id @default(autoincrement())
  value_of_claim          Float
  year_of_entry   DateTime
  heritageId   Int
  heritage Heritage @relation(fields: [heritageId], references: [id])
}

model Obligations {
  id             Int        @id @default(autoincrement())
  value_of_obligation          Float
  year_of_entry   DateTime
  heritageId   Int
  heritage Heritage @relation(fields: [heritageId], references: [id])
}

model Real_State {
  id          Int      @id @default(autoincrement())
  name        String
  description   String?
  value_of_real_state       Decimal
  year_of_purchase DateTime
  deprecation Decimal
  assetId       Int
  asset         Assets     @relation(fields: [assetId], references: [id])
}

model Lands {
  id          Int      @id @default(autoincrement())
  name        String
  description   String?
  value_of_land       Decimal
  year_of_purchase DateTime
  deprecation Decimal
  assetId       Int
  asset         Assets     @relation(fields: [assetId], references: [id])
}

model Vehicles {
  id          Int      @id @default(autoincrement())
  name        String
  description   String?
  value_of_vehicle       Decimal
  year_of_purchase DateTime
  deprecation Decimal
  assetId       Int
  asset         Assets     @relation(fields: [assetId], references: [id])
}

model Equity_Interests {
  id          Int      @id @default(autoincrement())
  type        String
  description   String?
  value_of_equity_interests       Decimal
  year_of_purchase DateTime
  assetId       Int
  asset         Assets     @relation(fields: [assetId], references: [id])
}

model Other_Investments {
  id          Int      @id @default(autoincrement())
  types        String
  description   String?
  value_of_other_investments       Decimal
  year_of_purchase DateTime
  assetId       Int
  asset         Assets     @relation(fields: [assetId], references: [id])
}